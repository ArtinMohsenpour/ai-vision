# Local PostgreSQL (docker-compose.yml). Must match DATABASE_URL.
POSTGRES_USER=aivision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aivision
DATABASE_URL=postgres://aivision:change-me@127.0.0.1:5437/aivision

# Long random string, e.g. `openssl rand -hex 32`. Never commit the real value.
PAYLOAD_SECRET=

# Public site URL without a trailing slash. Match the exact hostname and port
# you open in your browser so Payload accepts the admin session on saves.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# In development, send account emails to Mailpit (docker compose up -d mailpit).
RHEINO_MAILPIT=1

# Transactional email for verification and password recovery. Use the provider's authenticated
# sender and TLS SMTP port (587 for STARTTLS or 465 for direct TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Set only if a trusted reverse proxy overwrites this header with one client IP
# and the Next.js server cannot be reached around that proxy.
CUSTOMER_AUTH_IP_HEADER=
