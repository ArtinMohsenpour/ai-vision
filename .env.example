# Local PostgreSQL (docker-compose.yml). Must match DATABASE_URL.
POSTGRES_USER=aivision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aivision
DATABASE_URL=postgres://aivision:change-me@127.0.0.1:5437/aivision

# Long random string, e.g. `openssl rand -hex 32`. Never commit the real value.
PAYLOAD_SECRET=

# Public base URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
